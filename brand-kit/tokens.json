{
  "name": "Unlimit Code",
  "version": "1.0.0",
  "format": "Plain JSON design reference; CSS implementation is theme.css",
  "color": {
    "paper": "#fdfcfc",
    "ink": "#201d1d"
  },
  "themes": {
    "paper": { "background": "#fdfcfc", "foreground": "#201d1d", "border": "#201d1d", "actionBackground": "#201d1d", "actionForeground": "#fdfcfc", "focus": "#201d1d" },
    "ink": { "background": "#201d1d", "foreground": "#fdfcfc", "border": "#fdfcfc", "actionBackground": "#fdfcfc", "actionForeground": "#201d1d", "focus": "#fdfcfc" }
  },
  "typography": {
    "family": "IBM Plex Mono",
    "fallback": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"],
    "weights": {"regular":400,"medium":500,"semibold":600},
    "sizeRem": {"label":0.75,"small":0.875,"body":1,"lead":1.125,"h3":1.5},
    "display": {"size":"clamp(2.25rem, 5.6vw, 5rem)","weight":500,"lineHeight":1.08,"trackingEm":-0.045},
    "h2": {"size":"clamp(1.75rem, 3.1vw, 3rem)","weight":500,"lineHeight":1.2,"trackingEm":-0.035},
    "body": {"lineHeight":1.65,"maxWidthCh":60},
    "label": {"trackingEm":0.08,"weight":500,"case":"uppercase"},
    "wordmark": {"weight":600,"trackingEm":0.025},
    "fontDisplay":"swap",
    "ligatures":false
  },
  "spacingPx": [4,8,12,16,24,32,48,64,96],
  "layout": {
    "maxWidthPx":1200,
    "gutter":"clamp(20px, 4vw, 56px)",
    "sectionSpacing":"clamp(56px, 7vw, 96px)",
    "desktopColumns":12,
    "compactBreakpointPx":1000,
    "stackBreakpointPx":720,
    "smallBreakpointPx":400
  },
  "components": {
    "radiusPx":0,
    "borderPx":1,
    "shadow":"none",
    "controlMinHeightPx":48,
    "buttonPaddingXPx":20,
    "inputPaddingXPx":16,
    "focusWidthPx":2,
    "focusOffsetPx":4,
    "errorBorder":"2px dashed",
    "disabledBorderStyle":"dashed"
  },
  "motion": {
    "durationMs":120,
    "easing":"cubic-bezier(.2, 0, 0, 1)",
    "reducedMotion":"none",
    "continuousAnimation":false
  },
  "assets": {
    "selectedIcon":"assets/unlimit-code-icon-original.png",
    "wordmarkArtwork":"assets/unlimit-code-wordmark.png",
    "logoHoldingColor":"#fdfcfc",
    "iconCanvasMinPx":32,
    "headerIconCanvasPx":[48,64]
  }
}
